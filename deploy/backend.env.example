# Copy the existing private backend/.env values into the deployed backend's .env file.
# Keep secrets out of source control. The deployment service should bind only to localhost.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
DATABASE_URL=file:./dev.db
DISCOGS_TOKEN=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
YOUTUBE_API_KEY=
